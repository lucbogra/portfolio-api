+
+    static fromDomain(tag: Tag): TagResponseDto {
+        const dto = new TagResponseDto();
+        dto.id = tag.id.toString();
+        dto.nom = tag.nom;
+        dto.type = tag.type.value;
+
+        return dto;
+    }
