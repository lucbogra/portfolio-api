{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "useESM": true }]
  },
  "moduleNameMapper": {
    "^src/(.*)\\.js$": "<rootDir>/src/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "testMatch": ["<rootDir>/test/**/*.e2e-spec.ts"],
  "setupFiles": ["<rootDir>/test/jest-e2e.setup.ts"],
  "maxWorkers": 1
}